// Shop Scout — relational store for users, catalog, price intelligence, and search history.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")      // pooled — used at runtime
  directUrl = env("DATABASE_URL_UNPOOLED")    // direct — used for migrations
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  name           String
  passwordHash   String
  zipCode        String?
  addressJson    String          @default("{}")
  preferencesJson String         @default("{}")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  searchSessions SearchSession[]
  savedOffers    SavedOffer[]
  learningEvents LearningEvent[]

  @@index([email])
}

/// Canonical commerce identity (one row per catalog product).
model Product {
  id                     String       @id @default(cuid())
  catalogId              String       @unique
  slug                   String       @unique
  title                  String
  brand                  String
  brandCanonical         String?
  brandRaw               String?
  upc                    String?
  gtin                   String?
  mpn                    String?
  manufacturerPartNumber String?
  category               String
  sizeLabel              String       @default("1 unit")
  basePriceUsd           Float
  unitLabel              String       @default("each")
  imageUrl               String?
  keywordsJson           String       @default("[]")
  organic                Boolean      @default(false)
  popularityScore        Float        @default(0)
  searchFrequency        Int          @default(0)
  clickFrequency         Int          @default(0)
  refreshPriority        Int          @default(50)
  embeddingJson          String?
  // ── Verification pipeline (a Product is the canonical, publishable identity) ──
  processingStatus       String       @default("PUBLISHED") // pipeline state
  validationStatus       String       @default("approved")  // approved|needs_review|rejected
  confidenceScore        Int          @default(100)         // 0–100
  validationReasonsJson  String       @default("[]")
  duplicateGroupId       String?
  published              Boolean      @default(true)
  lastVerifiedAt         DateTime?
  lastPriceCheck         DateTime?
  lastInventoryCheck     DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  aliases                ProductAlias[]
  variantGroups          VariantGroup[]
  variants               ProductVariant[]
  priceQuotes            PriceQuote[]
  priceHistory           PriceHistorySnapshot[]
  priceObservations      PriceHistory[]
  priceStats             ProductRetailerPriceStats[]
  identifiers            ProductIdentifier[]
  retailerIdentities     RetailerProductIdentity[]

  @@index([category])
  @@index([upc])
  @@index([gtin])
  @@index([brand])
  @@index([brandCanonical])
  @@index([refreshPriority])
  @@index([published])
  @@index([validationStatus])
  @@index([duplicateGroupId])
}

model Retailer {
  id              String   @id
  name            String
  sourceType      String   @default("direct")
  websiteUrl      String?
  affiliateNetwork String?
  enabled         Boolean  @default(true)
  qualityScore    Float    @default(0.5)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([enabled])
  @@index([sourceType])
}

model Category {
  id        String   @id
  name      String
  parentId  String?
  path      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([path])
}

model BrandCanonical {
  id          String   @id @default(cuid())
  canonical   String   @unique
  aliasesJson String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductIdentifier {
  id             String   @id @default(cuid())
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantGroupId String?
  variantId      String?
  type           String
  value          String
  source         String   @default("catalog")
  confidence     Float    @default(1)
  createdAt      DateTime @default(now())

  @@unique([type, value])
  @@index([productId])
  @@index([variantGroupId])
  @@index([variantId])
}

model ProductAlias {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  alias     String
  source    String   @default("keyword")

  @@unique([productId, alias])
  @@index([alias])
}

/// Visual variant (color/style) — one canonical image + retailer URL map for all sizes.
model VariantGroup {
  id                     String           @id @default(cuid())
  productId              String
  product                Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  catalogGroupId         String
  color                  String?
  colorNormalized        String?
  styleKey               String?
  upc                    String?
  gtin                   String?
  mpn                    String?
  manufacturerPartNumber String?
  canonicalImageUrl      String?
  retailerImageUrlsJson  String           @default("{}")
  imageSource            String?
  imageConfidence        Float?
  imageQualityJson       String           @default("{}")
  matchConfidence        Float?
  identityConfidence     Float?
  attributeConfidence    Float?
  confidenceReasonsJson  String           @default("[]")
  lastVerifiedAt         DateTime?
  attributesJson         String           @default("{}")
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  sizes                  ProductVariant[]

  @@unique([productId, catalogGroupId])
  @@index([colorNormalized])
  @@index([lastVerifiedAt])
  @@index([upc])
  @@index([gtin])
}

/// Size SKU under a VariantGroup — inherits group images unless sizeSpecificImageUrl set.
model ProductVariant {
  id                     String        @id @default(cuid())
  productId              String
  product                Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantGroupId         String
  variantGroup           VariantGroup    @relation(fields: [variantGroupId], references: [id], onDelete: Cascade)
  catalogVariantId       String
  sizeLabel              String
  sizeNormalized         String
  sizeKind               String        @default("unknown")
  upc                    String?
  gtin                   String?
  mpn                    String?
  manufacturerPartNumber String?
  sizeSpecificImageUrl   String?
  keywordsJson           String        @default("[]")
  basePriceUsd           Float?
  isDefault              Boolean       @default(false)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@unique([productId, catalogVariantId])
  @@index([variantGroupId])
  @@index([sizeNormalized])
  @@index([gtin])
  @@index([upc])
}

/// One row = one retailer offer for a product (nightly index, Amazon API, or live search).
/// Photos stored as HTTPS URLs only — not binary blobs (keeps DB small and fast).
/// Retailer offer row (listing + price) linked to canonical product identity.
model PriceQuote {
  id                    String   @id @default(cuid())
  productId             String
  product               Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantGroupId        String?
  variantId             String?
  retailerId            String
  channel               String
  storeTitle            String?
  imageUrl              String?
  priceUsd              Float
  wasPriceUsd           Float?
  shippingUsd           Float?
  estimatedTaxUsd       Float?
  deliveredTotalUsd     Float?
  landedCostUsd         Float
  unitPriceUsd          Float
  inStock               Boolean  @default(true)
  matchConfidence       Float    @default(0.9)
  identityConfidence    Float?
  attributeConfidence   Float?
  imageConfidence       Float?
  confidenceReasonsJson String   @default("[]")
  source                String
  providerSource        String?
  sourceLabel           String?
  externalOfferId       String?
  sellerName            String?
  sellerFeedbackPct     Float?
  sellerFeedbackScore   Int?
  condition             String?
  returnPolicy          String?
  productUrl            String
  affiliateUrl          String
  fetchedAt             DateTime @default(now())
  expiresAt             DateTime
  // ── Verification pipeline (retailer-specific offer) ──
  validationStatus      String   @default("approved") // approved|needs_review|rejected
  confidenceScore       Int      @default(90)          // 0–100
  validationReasonsJson String   @default("[]")
  duplicateGroupId      String?
  lastVerifiedAt        DateTime?
  lastPriceCheck        DateTime?
  lastInventoryCheck    DateTime?

  qaReview              InventoryQaReview?

  @@index([productId, retailerId, channel])
  @@index([productId, expiresAt])
  @@index([variantGroupId])
  @@index([source, expiresAt])
  @@index([retailerId, fetchedAt])
  @@index([providerSource, fetchedAt])
  @@index([externalOfferId])
}

/// Human-in-the-loop QA for persisted verified quotes before scaling inventory.
model InventoryQaReview {
  id           String     @id @default(cuid())
  priceQuoteId String     @unique
  priceQuote   PriceQuote @relation(fields: [priceQuoteId], references: [id], onDelete: Cascade)
  catalogId    String
  status       String     @default("pending")
  tagsJson     String     @default("[]")
  notes        String?
  reviewedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([catalogId])
  @@index([status])
}

/// Retailer-scoped listing identity before / during canonical linkage.
model RetailerProductIdentity {
  id                     String   @id @default(cuid())
  retailerId             String
  externalSku            String?
  retailerBrandRaw       String?
  storeTitle             String
  productUrl             String
  upc                    String?
  gtin                   String?
  mpn                    String?
  manufacturerPartNumber String?
  productId              String?
  product                Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantGroupId         String?
  variantId              String?
  rawAttributesJson      String   @default("{}")
  lastSeenAt             DateTime @default(now())
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([retailerId, productUrl])
  @@index([productId])
  @@index([upc])
  @@index([gtin])
  @@index([retailerId, lastSeenAt])
}

/// One observation per product + store per day — rollup-friendly daily view.
model PriceHistorySnapshot {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  retailerId String
  channel    String   @default("online")
  priceUsd   Float
  storeTitle String?
  imageUrl   String?
  source     String
  observedAt DateTime @default(now())

  @@index([productId, retailerId, observedAt])
  @@index([retailerId, observedAt])
  @@index([observedAt])
}

/// Append-only price observations (never overwrite — supports trends & volatility).
model PriceHistory {
  id                    String   @id @default(cuid())
  productId             String
  product               Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantGroupId        String?
  variantId             String?
  retailerId            String
  channel               String   @default("online")
  observedPrice         Float
  availability          Boolean  @default(true)
  source                String
  storeTitle            String?
  imageUrl              String?
  matchConfidence       Float?
  identityConfidence    Float?
  confidenceReasonsJson String?
  observedAt            DateTime @default(now())

  @@index([productId, retailerId, observedAt])
  @@index([variantGroupId, observedAt])
  @@index([variantId, observedAt])
  @@index([observedAt])
}

/// Rolling price intelligence per product × retailer (verified offers only).
model ProductRetailerPriceStats {
  id                   String    @id @default(cuid())
  productId            String
  product              Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  retailerId           String
  channel              String    @default("online")
  firstSeenPriceUsd    Float?
  firstSeenAt          DateTime?
  lowestPriceUsd       Float?
  lowestPriceAt        DateTime?
  movingAvgPriceUsd    Float?
  lastVerifiedPriceUsd Float?
  lastVerifiedAt       DateTime?
  verificationCount    Int       @default(0)
  updatedAt            DateTime  @updatedAt

  @@unique([productId, retailerId, channel])
  @@index([productId])
  @@index([retailerId])
}

/// Persistent retailer scrape/parser quality (used in deal ranking).
model RetailerQualityMetric {
  id                 String   @id @default(cuid())
  retailerId         String   @unique
  fetchAttempts      Int      @default(0)
  fetchSuccesses     Int      @default(0)
  parserAttempts     Int      @default(0)
  parserSuccesses    Int      @default(0)
  offersRejected     Int      @default(0)
  offersAccepted     Int      @default(0)
  avgMatchConfidence Float    @default(0)
  avgFetchLatencyMs  Float    @default(0)
  trustScore         Float    @default(0.5)
  updatedAt          DateTime @updatedAt
}

model SearchSession {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  zipCode      String
  queryRaw     String
  intentJson   String
  mode         String   @default("search")
  resultCount  Int      @default(0)
  bestPriceUsd Float?
  durationMs   Int?
  createdAt    DateTime @default(now())
  queries      SearchQuery[]

  @@index([userId, createdAt])
  @@index([createdAt])
}

model SearchQuery {
  id              String        @id @default(cuid())
  sessionId       String
  session         SearchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  resolvedCatalogId String?
  queryNormalized String
  attributesJson  String        @default("{}")
  offerCount      Int           @default(0)
  createdAt       DateTime      @default(now())

  @@index([sessionId])
}

model LearningEvent {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind        String
  payloadJson String
  createdAt   DateTime @default(now())

  @@index([userId, kind, createdAt])
}

model SavedOffer {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  offerJson String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Key/value config and feature flags (connector TTLs, maintenance mode).
model SystemConfig {
  key       String   @id
  valueJson String
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Bright Data + Product Verification Pipeline
//   RAW → CHECKED → MATCHED → VERIFIED → PUBLISHED  (+ STALE / NEEDS_REVIEW / REJECTED)
// Nothing scraped is shown to users until it reaches PUBLISHED. Status values are
// stored as strings (matching house style) and constrained by TS unions in
// src/lib/pipeline/types.ts.
// ─────────────────────────────────────────────────────────────────────────────

/// One row per retailer dataset. Adding a retailer = adding a row, never a new client.
model RetailerSource {
  id                  String   @id @default(cuid())
  retailerName        String
  retailerDomain      String
  brightDataDatasetId String
  inputType           String   @default("url") // url | keyword | category | upc | sku
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([retailerDomain, brightDataDatasetId])
  @@index([active])
  @@index([retailerName])
}

/// Raw Bright Data results, stored exactly as received. Never published directly.
model RawProductRecord {
  id                    String   @id @default(cuid())
  retailer              String
  retailerDomain        String?
  productUrl            String?
  title                 String?
  brand                 String?
  imageUrl              String?
  price                 Float?
  availability          String?
  upcGtin               String?
  ean                   String?
  gtin                  String?
  modelNumber           String?
  size                  String?
  quantity              String?
  unitCount             Int?
  color                 String?
  variant               String?
  category              String?
  scrapedAt             DateTime @default(now())
  rawJson               String   @default("{}")
  processingStatus      String   @default("RAW") // RAW|CHECKED|MATCHED|VERIFIED|PUBLISHED|STALE|NEEDS_REVIEW|REJECTED
  validationStatus      String? // approved|needs_review|rejected
  confidenceScore       Int? // 0–100
  validationReasonsJson String   @default("[]")
  duplicateGroupId      String?
  matchedProductId      String? // canonical Product.id once MATCHED
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([processingStatus])
  @@index([validationStatus])
  @@index([retailer])
  @@index([upcGtin])
  @@index([duplicateGroupId])
  @@index([matchedProductId])
  @@index([scrapedAt])
}

/// Append-only audit trail of every validation / status transition.
model ValidationLog {
  id                 String   @id @default(cuid())
  productId          String?
  rawProductRecordId String?
  oldStatus          String?
  newStatus          String
  score              Int?
  reasonsJson        String   @default("[]")
  aiUsed             Boolean  @default(false)
  aiResultJson       String?
  adminOverride      Boolean  @default(false)
  adminUserId        String?
  createdAt          DateTime @default(now())

  @@index([productId, createdAt])
  @@index([rawProductRecordId, createdAt])
  @@index([newStatus, createdAt])
}

/// User-submitted product requests from the zero-results "suggest a product" form.
model ProductRequest {
  id           String    @id @default(cuid())
  productQuery String
  userEmail    String
  status       String    @default("pending")
  notifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([userEmail])
}
